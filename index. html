<style>
/* Layout: sticky header (brand right, currency + menu left), side drawer, one view per section, bottom cart bar. Single dark-gold look by choice. */
:root{
  --bg:#0f0d0a; --surface:#1a1712; --raise:#221e17; --line:#2e281e; --fg:#f3ece0; --muted:#a89c86;
  --gold:#d4a937; --gold-hi:#f4d27a; --gold-lo:#8a6a1c; --ok:#5fb37a; --bad:#e08b88; --bad-line:#b3615f;
  --display:"Reem Kufi","IBM Plex Sans Arabic",Tahoma,sans-serif;
  --body:"IBM Plex Sans Arabic",Tahoma,"Segoe UI",sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:15px;line-height:1.6;direction:rtl;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-bottom:100px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.wrap{max-width:980px;margin:0 auto}
a{color:inherit}
button{font:inherit}
button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible,a:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:8;background:var(--bg);border-bottom:1px solid var(--line);
  display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.brand b{font-family:var(--display);font-size:21px;color:var(--gold-hi)}
.hd-actions{display:flex;gap:8px;align-items:center}
select{background:var(--surface);color:var(--fg);border:1px solid var(--line);border-radius:10px;padding:8px 10px;font:inherit;font-size:13px;max-width:150px}
.burger{width:42px;height:42px;border-radius:10px;border:1px solid var(--line);background:var(--surface);cursor:pointer;display:grid;place-content:center;gap:5px;position:relative}
.burger span{display:block;width:20px;height:2px;border-radius:2px;background:var(--gold-hi)}
.dot{position:absolute;top:-4px;left:-4px;background:var(--gold);color:#1a1408;border-radius:999px;font-size:11px;padding:0 6px;font-weight:600}

.scrim{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:30}
.drawer{position:fixed;inset:0 auto 0 0;width:min(300px,86vw);background:var(--surface);border-inline-end:1px solid var(--gold-lo);z-index:31;overflow:auto;
  padding:calc(18px + env(safe-area-inset-top,0px)) 16px calc(18px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.drawer h4{font-family:var(--display);color:var(--gold-hi);margin:14px 0 6px;font-size:15px}
.drawer a{display:flex;justify-content:space-between;align-items:center;text-decoration:none;padding:10px 12px;border-radius:10px;color:var(--fg)}
.drawer a:hover,.drawer a[aria-current="page"]{background:var(--raise);color:var(--gold-hi)}
.drawer .sub a{padding-inline-start:22px;font-size:14px}
.drawer .close{background:none;border:0;color:var(--muted);cursor:pointer;font-size:14px;padding:4px 0}

h1,h2,h3{text-wrap:balance}
h2{font-family:var(--display);font-size:22px;margin:24px 0 6px;color:var(--gold-hi)}
.lead{color:var(--muted);margin:0 0 16px;max-width:60ch}
.hero{display:flex;flex-direction:column;align-items:center;text-align:center;padding-block:32px 8px;gap:10px}
.hero-logo{width:min(220px,60vw);height:auto;aspect-ratio:1;max-width:100%;border-radius:28px;border:1px solid var(--gold-lo);box-shadow:0 10px 40px rgba(212,169,55,.25)}
.brand-img{width:38px;height:38px;border-radius:50%;border:1px solid var(--gold-lo);object-fit:cover}
.hero h1{font-family:var(--display);font-size:clamp(30px,7vw,46px);margin:0;line-height:1.2}
.hero h1 span{color:var(--gold)}
.hero p{color:var(--muted);margin:0;max-width:46ch}
.pays{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:4px}
.chip{border:1px solid var(--line);border-radius:999px;padding:3px 11px;font-size:12px;color:var(--muted)}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px;min-width:0}
.card.gold{border-color:var(--gold-lo);background:linear-gradient(180deg,var(--raise),var(--surface))}
.card .tag{font-size:12px;letter-spacing:.4px;color:var(--gold)}
.card h3{margin:0;font-size:17px;font-weight:600}
.card p{margin:0;color:var(--muted);font-size:14px;flex:1}
.ribbon{display:flex;gap:6px;flex-wrap:wrap}
.gbadge{font-size:12px;font-weight:600;border-radius:999px;padding:2px 10px;background:linear-gradient(180deg,var(--gold-hi),var(--gold));color:#1a1408}
.obadge{font-size:12px;border-radius:999px;padding:1px 10px;border:1px solid var(--gold-lo);color:var(--gold-hi)}
.row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px;flex-wrap:wrap}
.price{font-weight:600;font-variant-numeric:tabular-nums;color:var(--gold-hi)}
.old{color:var(--muted);text-decoration:line-through;font-size:13px;margin-inline-start:6px;font-variant-numeric:tabular-nums}
.btn{cursor:pointer;border:0;border-radius:10px;padding:9px 14px;font-weight:600;background:linear-gradient(180deg,var(--gold-hi),var(--gold));color:#1a1408;text-decoration:none;display:inline-block}
.btn.ghost{background:transparent;color:var(--fg);border:1px solid var(--line)}
.btn.no{background:transparent;color:var(--bad);border:1px solid var(--bad-line)}
.btn:disabled{opacity:.6;cursor:default}

.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
@media (max-width:560px){.tiles{grid-template-columns:repeat(2,1fr)}}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;text-decoration:none;display:flex;flex-direction:column;gap:2px;min-width:0}
.tile b{font-size:15px}
.tile small{color:var(--muted)}
.tile .n{font-family:var(--display);color:var(--gold);font-size:13px}

.opts{display:flex;flex-direction:column;gap:8px}
.optrow{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.optlab{font-size:12px;color:var(--muted);min-width:44px}
.opt{cursor:pointer;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-size:13px}
.opt[aria-pressed="true"]{border-color:var(--gold);color:var(--gold-hi);box-shadow:inset 0 0 0 1px var(--gold)}

.form{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:14px;max-width:640px}
.welcome{background:var(--raise);border:1px solid var(--gold-lo);border-radius:12px;padding:12px 14px;color:var(--gold-hi);font-size:14px}
.field{display:flex;flex-direction:column;gap:5px}
.field label,.field .lab{font-weight:600;font-size:14px}
.field .hint{color:var(--muted);font-size:12px}
input[type=text],input[type=url],input[type=email],input[type=tel],textarea{width:100%;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:10px;padding:10px 12px;font:inherit}
textarea{min-height:76px;resize:vertical}
.err{color:var(--bad);font-size:13px}
.note{color:var(--muted);font-size:12px;margin:10px 0 0}

.status{border-radius:14px;padding:16px;border:1px solid var(--line);background:var(--surface);margin-top:18px}
.status.wait{border-color:var(--gold-lo)} .status.ok{border-color:var(--ok)} .status.no{border-color:var(--bad-line)}
.status h3{font-family:var(--display);margin:0 0 6px;color:var(--gold-hi)}
.dua{color:var(--gold-hi);font-family:var(--display);font-size:17px;line-height:1.8;margin:10px 0 0}
.code{font-family:ui-monospace,Menlo,monospace;color:var(--gold-hi);user-select:all}

.wa{display:flex;flex-direction:column;gap:12px;max-width:640px}
.wa ul{margin:0;padding-inline-start:20px;color:var(--muted)}
.wa .num{font-family:ui-monospace,Menlo,monospace;font-size:18px;color:var(--gold-hi);user-select:all;direction:ltr;unicode-bidi:isolate}

.bar{position:fixed;inset:auto 0 0;background:var(--surface);border-top:1px solid var(--gold-lo);z-index:6;
  padding:12px max(16px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.bar .in{max-width:980px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:12px}
.sheet{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:20;display:flex;align-items:flex-end;justify-content:center}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px 18px 0 0;width:100%;max-width:540px;max-height:88vh;overflow:auto;
  padding:20px max(16px,env(safe-area-inset-right,0px)) calc(20px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.panel h3{font-family:var(--display);margin:0 0 12px;color:var(--gold-hi)}
.line{display:flex;justify-content:space-between;gap:8px;padding:8px 0;border-bottom:1px dashed var(--line);font-variant-numeric:tabular-nums}
.line .det{display:block;color:var(--muted);font-size:12px}
.line button{background:none;border:0;color:var(--muted);cursor:pointer}
.methods{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
.m{cursor:pointer;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px;color:var(--fg);font-weight:600;text-align:center}
.m[aria-pressed="true"]{border-color:var(--gold);box-shadow:inset 0 0 0 1px var(--gold)}
.m.apple{grid-column:1/-1;background:#000;color:#fff}

.orders{display:flex;flex-direction:column;gap:12px}
.order{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:6px;min-width:0;overflow-wrap:anywhere}
.order.pending{border-color:var(--gold-lo)}
.order .meta{color:var(--muted);font-size:13px}
.order dl{margin:4px 0 0;display:grid;grid-template-columns:auto 1fr;gap:2px 10px;font-size:13px}
.order dt{color:var(--muted)} .order dd{margin:0}
.pill{display:inline-block;border-radius:999px;padding:1px 10px;font-size:12px;border:1px solid var(--line)}
.pill.pending{color:var(--gold-hi);border-color:var(--gold-lo)} .pill.accepted{color:var(--ok);border-color:var(--ok)} .pill.rejected{color:var(--bad);border-color:var(--bad-line)}
footer{color:var(--muted);font-size:13px;text-align:center;padding-block:28px}
@media (prefers-reduced-motion:no-preference){.shine{animation:sh 4s ease-in-out infinite}@keyframes sh{0%,70%{opacity:0}85%{opacity:.55}100%{opacity:0}}}
body{margin:0}
[hidden]{display:none!important}
img{max-width:100%}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f7dc8b"/><stop offset=".5" stop-color="#d4a937"/><stop offset="1" stop-color="#7d5e17"/></linearGradient>
    <linearGradient id="g2" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4d27a"/><stop offset="1" stop-color="#a9821f"/></linearGradient>
    <symbol id="coin" viewBox="0 0 120 120">
      <circle cx="60" cy="60" r="56" fill="url(#g)"/>
      <circle cx="60" cy="60" r="47" fill="none" stroke="#6b4f12" stroke-width="2"/>
      <circle cx="60" cy="60" r="43" fill="url(#g2)"/>
      <g fill="#5a420e"><circle cx="60" cy="10" r="2"/><circle cx="60" cy="110" r="2"/><circle cx="10" cy="60" r="2"/><circle cx="110" cy="60" r="2"/></g>
      <text x="60" y="78" text-anchor="middle" font-family="Georgia, serif" font-weight="700" font-size="50" fill="#4a360b">Z</text>
    </symbol>
  </defs>
</svg>

<header class="wrap top">
  <a class="brand" href="#"><img class="brand-img" src="data:image/jpeg;base64," alt="" width="38" height="38"><b>زيرو شوب</b></a>
  <div class="hd-actions">
    <select id="cur" aria-label="العملة"></select>
    <button class="burger" id="menuBtn" aria-label="القائمة" aria-expanded="false"><span></span><span></span><span></span><b class="dot" id="pendDot" hidden>0</b></button>
  </div>
</header>

<div class="scrim" id="scrim" hidden></div>
<nav class="drawer" id="drawer" hidden aria-label="القائمة">
  <button class="close" id="closeMenu">✕ إغلاق</button>
  <a href="#">الرئيسية</a>
  <h4>منتجات الدسكورد</h4>
  <div class="sub">
    <a href="#files">ملفات البوتات</a>
    <a href="#nitro">النيترو</a>
    <a href="#design">تصميم صور</a>
    <a href="#server-design">تصميم سيرفر</a>
    <a href="#clone">نسخ سيرفر</a>
  </div>
  <h4>خدمات</h4>
  <a href="#my-store">نسوي لك متجرك</a>
</nav>

<main class="wrap">
  <!-- الرئيسية -->
  <section data-view="home">
    <div class="hero">
      <img class="hero-logo" src="data:image/jpeg;base64," alt="شعار زيرو شوب" width="220" height="220">
      <h1>زيرو <span>شوب</span></h1>
      <p>ملفات بوتات، نيترو وتصاميم سيرفرات. كل شي لسيرفرك في مكان واحد.</p>
      <div class="pays"><span class="chip">تحويل بنكي</span><span class="chip">STC Pay</span><span class="chip">تسليم سريع</span></div>
    </div>
    <h2>عروض الضمان الذهبي</h2>
    <p class="lead">منتجات مضمونة بخصم أو ببلاش لفترة محدودة.</p>
    <div class="grid" id="featured"></div>
    <h2>منتجات الدسكورد</h2>
    <div class="tiles">
      <a class="tile" href="#files"><span class="n">1</span><b>ملفات البوتات</b><small>سيستم، بنك، عسكري</small></a>
      <a class="tile" href="#nitro"><span class="n">2</span><b>النيترو</b><small>كامل وبيسك · شهر</small></a>
      <a class="tile" href="#design"><span class="n">3</span><b>تصميم صور</b><small>لوقو، بنر، إنفو</small></a>
      <a class="tile" href="#server-design"><span class="n">4</span><b>تصميم سيرفر</b><small>RP · VRP · غيرها</small></a>
      <a class="tile" href="#clone"><span class="n">5</span><b>نسخ سيرفر</b><small>من رابط لرابط</small></a>
    </div>
  </section>

  <section data-view="files" hidden>
    <h2>ملفات البوتات</h2>
    <p class="lead">ملفات جاهزة تشغلها على استضافتك. تستلم الملف بعد قبول الطلب.</p>
    <div class="grid" id="filesGrid"></div>
  </section>


  <section data-view="nitro" hidden>
    <h2>النيترو</h2>
    <p class="lead">اختر النوع والمدة.</p>
    <div class="grid" id="nitroGrid"></div>
  </section>

  <section data-view="design" hidden>
    <h2>تصميم صور</h2>
    <p class="lead">عبّ الاستبيان وأضفه للسلة. السعر <strong class="price" data-sar="30"></strong>.</p>
    <form class="form" id="designForm" novalidate>
      <div class="welcome">مرحبا عزيزي العضو، يجب عليك تعبئة الاستبيان بشكل واضح وبدون أغلاط إملائية. سيتم مراجعة استبيانك بشكل دقيق.</div>
      <div id="designFields"></div>
      <p class="note">ملاحظة مهمة: عبّ بوضوح، يعني لا تكتب رقم فقط.</p>
      <p class="err" id="designErr" hidden></p>
      <button class="btn" type="submit">أضف للسلة</button>
    </form>
  </section>

  <section data-view="server-design" hidden>
    <h2>تصميم سيرفر</h2>
    <p class="lead">تجهيز كامل: بنرات، رتب ورومات. السعر <strong class="price" data-sar="140"></strong>.</p>
    <form class="form" id="serverForm" novalidate>
      <div class="field"><label for="sv-name">اسم السيرفر</label><input type="text" id="sv-name" autocomplete="off"></div>
      <div class="field"><span class="lab">نوع السيرفر</span>
        <div class="optrow" role="group" aria-label="نوع السيرفر">
          <button type="button" class="opt" data-sv="RP" aria-pressed="true">RP</button>
          <button type="button" class="opt" data-sv="VRP" aria-pressed="false">VRP</button>
          <button type="button" class="opt" data-sv="غير ذلك" aria-pressed="false">غير ذلك</button>
        </div>
      </div>
      <div class="field" id="sv-other" hidden><label for="sv-desc">وصف السيرفر اللي تبيه</label><span class="hint">اكتب بالتفصيل: الفكرة، الأقسام، الرتب.</span><textarea id="sv-desc"></textarea></div>
      <p class="err" id="serverErr" hidden></p>
      <button class="btn" type="submit">أضف للسلة</button>
    </form>
  </section>

  <section data-view="clone" hidden>
    <h2>نسخ سيرفر</h2>
    <p class="lead">ننسخ رومات ورتب وصلاحيات سيرفر لسيرفرك. السعر <strong class="price" data-sar="50"></strong>.</p>
    <form class="form" id="cloneForm" novalidate>
      <div class="field"><label for="cl-mine">رابط سيرفرك</label><span class="hint">السيرفر اللي بننسخ فيه</span><input type="url" id="cl-mine" placeholder="https://discord.gg/..." dir="ltr" autocomplete="off"></div>
      <div class="field"><label for="cl-src">رابط السيرفر المنسوخ</label><span class="hint">السيرفر اللي تبي نسخته</span><input type="url" id="cl-src" placeholder="https://discord.gg/..." dir="ltr" autocomplete="off"></div>
      <p class="err" id="cloneErr" hidden></p>
      <button class="btn" type="submit">أضف للسلة</button>
    </form>
  </section>

  <section data-view="my-store" hidden>
    <h2>نسوي لك متجرك</h2>
    <div class="wa">
      <p class="lead" style="margin:0">تبي متجر إلكتروني زي هذا باسمك وشعارك؟ نسويه لك كامل وتستلمه جاهز.</p>
      <ul>
        <li>شعار وهوية بالألوان اللي تبيها</li>
        <li>منتجاتك وأسعارك وخياراتها</li>
        <li>نظام طلبات تقبلها أو ترفضها</li>
        <li>كل العملات العربية والدولار واليورو</li>
      </ul>
      <div class="card gold">
        <span class="tag">تواصل معنا في دسكورد</span>
        <p style="margin:0">افتح تذكرة في سيرفرنا واكتب "أبي متجر".</p>
        <div class="row"><a class="btn discord-link" target="_blank" rel="noopener">افتح سيرفر زيرو شوب</a></div>
      </div>
    </div>
  </section>


  <p class="note">الأسعار بالعملات غير الريال تقريبية، والدفع النهائي بالريال السعودي.</p>
</main>

<footer class="wrap">© زيرو شوب · منتجات دسكورد رقمية</footer>

<div class="bar"><div class="in">
  <div><span id="count">0</span> منتج · <strong class="price" id="total">0</strong></div>
  <button class="btn" id="open">إتمام الطلب</button>
</div></div>

<div class="sheet" id="sheet" hidden>
  <div class="panel" role="dialog" aria-label="السلة">
    <h3>سلتك</h3>
    <div id="lines"></div>
    <div class="line"><strong>الإجمالي</strong><strong class="price" id="total2"></strong></div>
    <div class="methods">
      <button class="m" data-m="تحويل بنكي">تحويل بنكي</button>
      <button class="m" data-m="STC Pay">STC Pay</button>
    </div>
    <div id="result"></div>
    <div class="row"><button class="btn ghost" id="close">رجوع</button><button class="btn" id="pay">اطلب من دسكورد</button></div>
  </div>
</div>

<script>
const DISCORD_INVITE="https://discord.gg/"; // ← حط رابط دعوة سيرفر زيرو شوب هنا
document.querySelectorAll(".discord-link").forEach(a=>a.href=DISCORD_INVITE);
const $=s=>document.querySelector(s);
function esc(t){return String(t??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}

const files=[
  {id:"f-sys",tag:"ملف",name:"ملف بوت سيستم",desc:"تذاكر، ترحيب، رتب تلقائية وسجلات.",sar:80},
  {id:"f-bank",tag:"ملف",name:"ملف بوت بنك",desc:"حسابات، تحويلات، قروض وكشف حساب.",sar:40},
  {id:"f-mil",tag:"ملف",name:"ملف بوت عسكري",desc:"رتب عسكرية، ترقيات، حضور وسجل مخالفات.",sar:20}
];
const featured=[
  {id:"ft-mil",tag:"ملف",name:"ملف بوت عسكري",desc:"رتب، ترقيات وحضور. ببلاش لفترة محدودة.",sar:0,old:20,badge:"ببلاش"},
  {id:"ft-sys",tag:"ملف",name:"ملف بوت سيستم",desc:"تذاكر، ترحيب، رتب تلقائية وسجلات بسعر أقل.",sar:65,old:80,badge:"خصم 19%"}
];
const groups=[
 {g:"nitro",tag:"نيترو",name:"نيترو دسكورد",desc:"إيموجيات مخصصة، رفع ملفات أكبر وبروفايل مميز. الكامل فيه بوستين وبث بجودة عالية.",
  opts:[{label:"النوع",vals:["كامل","بيسك"]},{label:"المدة",vals:["شهر"]}],
  price:{"كامل|شهر":45,"بيسك|شهر":15}}
];
const choice={};groups.forEach(G=>choice[G.g]=G.opts.map(o=>o.vals[0]));
function variantOf(G){const k=choice[G.g].join("|");return{id:G.g+"-"+k,name:G.name+" · "+k.split("|").join(" · "),sar:G.price[k]}}

const survey=[
 {k:"name",label:"اسم الخادم",type:"text"},
 {k:"type",label:"نوع الخادم",hint:"بكل تفصيل.",type:"area"},
 {k:"short",label:"اختصار الخادم",type:"text"},
 {k:"color",label:"لون التصميم",type:"text"},
 {k:"logo",label:"اللوقو",type:"choice",opts:["ثابت","متحرك"]},
 {k:"banner",label:"البنر",type:"choice",opts:["ثابت","متحرك"]},
 {k:"font",label:"الخط",type:"choice",opts:["ثابت","متحرك"]},
 {k:"ads",label:"صور الإعلانات",hint:"لنظام الـ VRP فقط.",type:"choice",opts:["أبي","ما أبي"]},
 {k:"info",label:"صور الإنفو",hint:"مثل: الدعم الفني - طلب قيادة.",type:"area"},
 {k:"bots",label:"صور البوتات",hint:"يرجى ذكرها بشكل واضح.",type:"area"},
 {k:"extra",label:"إضافات أخرى",hint:"مثل: قوانين - بنر انفايت.",type:"area",optional:true}
];
const surveyPick={};survey.filter(q=>q.type==="choice").forEach(q=>surveyPick[q.k]=null);

// قيمة 1 ريال سعودي بكل عملة (تقريبية)
const rates=[
 ["SAR","ريال سعودي",1],["AED","درهم إماراتي",0.979],["KWD","دينار كويتي",0.0819],["QAR","ريال قطري",0.971],
 ["BHD","دينار بحريني",0.1003],["OMR","ريال عماني",0.1026],["JOD","دينار أردني",0.189],["IQD","دينار عراقي",349],
 ["EGP","جنيه مصري",13],["LYD","دينار ليبي",1.29],["TND","دينار تونسي",0.80],["DZD","دينار جزائري",35],
 ["MAD","درهم مغربي",2.45],["SDG","جنيه سوداني",160],["YER","ريال يمني",140],["SYP","ليرة سورية",3470],
 ["LBP","ليرة لبنانية",23870],["MRU","أوقية موريتانية",10.6],["SOS","شلن صومالي",152],["DJF","فرنك جيبوتي",47.4],
 ["KMF","فرنك قمري",116],["USD","دولار أمريكي",0.2667],["EUR","يورو",0.23]
];
const sel=$("#cur");rates.forEach(([c,n])=>sel.add(new Option(n+" ("+c+")",c)));
let cur="SAR";try{cur=localStorage.getItem("cur")||"SAR"}catch(e){}
if(!rates.some(r=>r[0]===cur))cur="SAR";sel.value=cur;
function fmtIn(sar,c){const r=rates.find(x=>x[0]===c)||rates[0];const v=sar*r[2];
  if(sar===0)return "مجاناً";
  return new Intl.NumberFormat("ar",{style:"currency",currency:r[0],maximumFractionDigits:v>=1000?0:(r[2]<0.2?3:2)}).format(v)}
const fmt=sar=>fmtIn(sar,cur);

// السلة: كل سطر له مفتاح، والخدمات اللي فيها استبيان سطر مستقل
let cart=[];let method=null;
function addItem(it,details){
  if(!details){const ex=cart.find(l=>l.id===it.id&&!l.details);if(ex){ex.qty++;render();return}}
  cart.push({key:it.id+"-"+Date.now(),id:it.id,name:it.name,sar:it.sar,qty:1,details:details||null});render();
}
const inCart=id=>cart.some(l=>l.id===id);

function cardHTML(p){
  return `<article class="card${p.badge?" gold":""}">${p.badge?`<div class="ribbon"><span class="gbadge">ضمان ذهبي</span><span class="obadge">${p.badge}</span></div>`:`<span class="tag">${p.tag}</span>`}
   <h3>${p.name}</h3><p>${p.desc}</p>
   <div class="row"><span><span class="price">${fmt(p.sar)}</span>${p.old?`<span class="old">${fmt(p.old)}</span>`:""}</span><button class="btn" data-add="${p.id}">${inCart(p.id)?"أُضيف ✓":"أضف للسلة"}</button></div></article>`}
function groupHTML(G){const v=variantOf(G);
  return `<article class="card"><span class="tag">${G.tag}</span><h3>${G.name}</h3><p>${G.desc}</p>
   <div class="opts">${G.opts.map((o,i)=>`<div class="optrow" role="group" aria-label="${o.label}"><span class="optlab">${o.label}</span>${o.vals.map(val=>`<button class="opt" data-g="${G.g}" data-i="${i}" data-v="${val}" aria-pressed="${choice[G.g][i]===val}">${val}</button>`).join("")}</div>`).join("")}</div>
   <div class="row"><span class="price">${fmt(v.sar)}</span><button class="btn" data-addg="${G.g}">${inCart(v.id)?"أُضيف ✓":"أضف للسلة"}</button></div></article>`}

function render(){
  $("#featured").innerHTML=featured.map(cardHTML).join("");
  $("#filesGrid").innerHTML=files.map(cardHTML).join("");
  $("#nitroGrid").innerHTML=groupHTML(groups.find(G=>G.g==="nitro"));
  document.querySelectorAll("[data-sar]").forEach(el=>el.textContent=fmt(+el.dataset.sar));
  const sum=cart.reduce((a,l)=>a+l.sar*l.qty,0);
  $("#count").textContent=cart.reduce((a,l)=>a+l.qty,0);$("#total").textContent=fmt(sum);$("#total2").textContent=fmt(sum);
  $("#lines").innerHTML=cart.length?cart.map(l=>`<div class="line"><span>${esc(l.name)} × ${l.qty}${l.details?`<span class="det">${esc(Object.values(l.details).filter(Boolean).slice(0,2).join(" · "))}</span>`:""}</span><span>${fmt(l.sar*l.qty)} <button data-rm="${l.key}" aria-label="حذف">✕</button></span></div>`).join(""):'<p class="note">السلة فاضية.</p>';
}

// الاستبيان
$("#designFields").innerHTML=survey.map(q=>{
  const hint=q.hint?`<span class="hint">${q.hint}</span>`:"";
  if(q.type==="choice")return `<div class="field"><span class="lab">${q.label}</span>${hint}<div class="optrow" role="group" aria-label="${q.label}">${q.opts.map(o=>`<button type="button" class="opt" data-q="${q.k}" data-v="${o}" aria-pressed="false">${o}</button>`).join("")}</div></div>`;
  const inp=q.type==="area"?`<textarea id="q-${q.k}"></textarea>`:`<input type="text" id="q-${q.k}" autocomplete="off">`;
  return `<div class="field"><label for="q-${q.k}">${q.label}${q.optional?' <span class="hint">(اختياري)</span>':""}</label>${hint}${inp}</div>`}).join("");
function showErr(id,msg){const e=$(id);e.textContent=msg;e.hidden=!msg}
const onlyNum=t=>/^[\d\s.,٠-٩]+$/.test(t);
$("#designForm").addEventListener("submit",e=>{e.preventDefault();
  const d={};
  for(const q of survey){
    if(q.type==="choice"){if(!surveyPick[q.k])return showErr("#designErr","اختر: "+q.label);d[q.label]=surveyPick[q.k];continue}
    const v=$("#q-"+q.k).value.trim();
    if(!v&&!q.optional)return showErr("#designErr","عبّ خانة: "+q.label);
    if(v&&onlyNum(v))return showErr("#designErr","خانة "+q.label+": اكتب بوضوح، لا تكتب رقم فقط.");
    if(v)d[q.label]=v;
  }
  showErr("#designErr","");addItem({id:"design",name:"تصميم صور",sar:30},d);
  e.target.reset();Object.keys(surveyPick).forEach(k=>surveyPick[k]=null);
  document.querySelectorAll("[data-q]").forEach(b=>b.setAttribute("aria-pressed","false"));
  $("#sheet").hidden=false;
});

// تصميم سيرفر
let svType="RP";
$("#serverForm").addEventListener("submit",e=>{e.preventDefault();
  const name=$("#sv-name").value.trim(),desc=$("#sv-desc").value.trim();
  if(!name)return showErr("#serverErr","اكتب اسم السيرفر.");
  if(svType==="غير ذلك"&&!desc)return showErr("#serverErr","اكتب وصف السيرفر اللي تبيه.");
  showErr("#serverErr","");
  const d={"اسم السيرفر":name,"النوع":svType};if(svType==="غير ذلك")d["الوصف"]=desc;
  addItem({id:"server-design",name:"تصميم سيرفر كامل",sar:140},d);e.target.reset();$("#sheet").hidden=false;
});

// نسخ سيرفر
const isDiscord=u=>/^(https?:\/\/)?(www\.)?(discord\.gg|discord\.com\/invite|discordapp\.com\/invite)\/[\w-]+/i.test(u);
$("#cloneForm").addEventListener("submit",e=>{e.preventDefault();
  const a=$("#cl-mine").value.trim(),b=$("#cl-src").value.trim();
  if(!isDiscord(a))return showErr("#cloneErr","رابط سيرفرك لازم يكون رابط دعوة دسكورد، مثل https://discord.gg/abc");
  if(!isDiscord(b))return showErr("#cloneErr","رابط السيرفر المنسوخ لازم يكون رابط دعوة دسكورد.");
  showErr("#cloneErr","");
  addItem({id:"clone",name:"نسخ سيرفر",sar:50},{"رابط سيرفرك":a,"رابط السيرفر المنسوخ":b});e.target.reset();$("#sheet").hidden=false;
});

// واتساب


// التنقل
const views=["home","files","nitro","design","server-design","clone","my-store","orders"];
function route(){let v=location.hash.slice(1);if(!views.includes(v))v="home";
  if(v==="orders"&&!isAdmin)v="home";
  document.querySelectorAll("[data-view]").forEach(s=>s.hidden=s.dataset.view!==v);
  const want="#"+(v==="home"?"":v);
  document.querySelectorAll(".drawer a").forEach(a=>{if(a.getAttribute("href")===want)a.setAttribute("aria-current","page");else a.removeAttribute("aria-current")});
  closeMenu();scrollTo(0,0)}
function openMenu(){$("#drawer").hidden=false;$("#scrim").hidden=false;$("#menuBtn").setAttribute("aria-expanded","true")}
function closeMenu(){$("#drawer").hidden=true;$("#scrim").hidden=true;$("#menuBtn").setAttribute("aria-expanded","false")}
$("#menuBtn").onclick=openMenu;$("#closeMenu").onclick=closeMenu;$("#scrim").onclick=closeMenu;
addEventListener("hashchange",route);

document.addEventListener("click",e=>{
  const q=e.target.closest("[data-q]");if(q){surveyPick[q.dataset.q]=q.dataset.v;document.querySelectorAll(`[data-q="${q.dataset.q}"]`).forEach(b=>b.setAttribute("aria-pressed",b===q));return}
  const sv=e.target.closest("[data-sv]");if(sv){svType=sv.dataset.sv;document.querySelectorAll("[data-sv]").forEach(b=>b.setAttribute("aria-pressed",b===sv));$("#sv-other").hidden=svType!=="غير ذلك";return}
  const op=e.target.closest(".opt[data-g]");if(op){choice[op.dataset.g][+op.dataset.i]=op.dataset.v;render();return}
  const a=e.target.closest("[data-add]");if(a){const p=[...featured,...files].find(x=>x.id===a.dataset.add);if(p)addItem(p);return}
  const ag=e.target.closest("[data-addg]");if(ag){addItem(variantOf(groups.find(G=>G.g===ag.dataset.addg)));return}
  const r=e.target.closest("[data-rm]");if(r){cart=cart.filter(l=>l.key!==r.dataset.rm);render();return}
  const m=e.target.closest(".m");if(m){method=m.dataset.m;document.querySelectorAll(".m").forEach(b=>b.setAttribute("aria-pressed",b===m));$("#result").innerHTML=""}
});
sel.onchange=()=>{cur=sel.value;try{localStorage.setItem("cur",cur)}catch(e){}render()};
$("#open").onclick=()=>{$("#sheet").hidden=false};
$("#close").onclick=()=>{$("#sheet").hidden=true};
$("#sheet").onclick=e=>{if(e.target.id==="sheet")$("#sheet").hidden=true};

// الطلب: يجهز ملخص الطلب وينسخه، ويفتح سيرفر الدسكورد
$("#pay").onclick=async()=>{
  const res=$("#result");
  if(!cart.length){res.innerHTML='<p class="note">أضف منتج أول.</p>';return}
  if(!method){res.innerHTML='<p class="note">اختر طريقة الدفع.</p>';return}
  const sum=cart.reduce((a,l)=>a+l.sar*l.qty,0);
  const text="طلب جديد من موقع زيرو شوب\n"+cart.map(l=>"• "+l.name+" × "+l.qty+(l.details?"\n  "+Object.entries(l.details).map(([k,v])=>k+": "+v).join("\n  "):"")).join("\n")+"\nالإجمالي: "+sum+"﷼\nطريقة الدفع: "+method;
  let copied=false;try{await navigator.clipboard.writeText(text);copied=true}catch(e){}
  res.innerHTML=`<div class="status wait"><h3>${copied?"نسخنا طلبك ✓":"انسخ طلبك"}</h3>افتح سيرفرنا، وافتح تذكرة طلب، والصق الطلب فيها.<pre style="white-space:pre-wrap;user-select:all;margin:10px 0 0;font:inherit;font-size:13px;color:var(--muted)">${esc(text)}</pre><div class="row"><a class="btn" href="${DISCORD_INVITE}" target="_blank" rel="noopener">افتح سيرفر زيرو شوب</a></div></div>`;
};

render();route();
</script>
</body>
</html>
